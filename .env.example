PORT=3000

# ── Optional: External MySQL Database ──────────────────────────────
# Leave blank to use the built-in local persistent store (.data/splitpesa-store.json).
# When populated, SplitPesa automatically creates the required tables on startup.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# ── Optional: Safaricom Daraja M-Pesa Express (STK Push) ───────────
# Leave blank to run in Demo / Practice Mode.
# Populate with your Daraja Sandbox or Production keys for live phone PIN prompts.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# ── Security Signing Secret ────────────────────────────────────────
MPESA_WEBHOOK_SECRET=replace-with-a-random-secret-string
